{
  "$id": "https://schemas.senagent.dev/surface-host-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "applicationInstance": {
          "type": [
            "object",
            "null"
          ]
        },
        "baseUrl": {
          "format": "uri",
          "type": "string"
        },
        "protocol": {
          "const": "senagent.surface-host.v1"
        },
        "refreshToken": {
          "type": "string"
        },
        "surfaceAccessToken": {
          "type": "string"
        },
        "surfaceId": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "type": {
          "const": "senagent.host.context"
        }
      },
      "required": [
        "type",
        "protocol",
        "baseUrl",
        "surfaceAccessToken",
        "templateId",
        "surfaceId",
        "applicationInstance"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "object"
        },
        "protocol": {
          "const": "senagent.surface-host.v1"
        },
        "type": {
          "const": "senagent.runtime.event"
        }
      },
      "required": [
        "type",
        "protocol",
        "event"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "senagent.surface-host.v1"
        },
        "surfaceId": {
          "type": "string"
        },
        "type": {
          "const": "senagent.surface.ready"
        }
      },
      "required": [
        "type",
        "protocol",
        "surfaceId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "applicationInstanceId": {
          "type": "string"
        },
        "protocol": {
          "const": "senagent.surface-host.v1"
        },
        "refreshToken": {
          "type": "string"
        },
        "surfaceId": {
          "type": "string"
        },
        "type": {
          "const": "senagent.surface.context.ready"
        }
      },
      "required": [
        "type",
        "protocol",
        "surfaceId",
        "applicationInstanceId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "object"
        },
        "protocol": {
          "const": "senagent.surface-host.v1"
        },
        "type": {
          "const": "senagent.surface.context.changed"
        }
      },
      "required": [
        "type",
        "protocol",
        "context"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "message": {
          "minLength": 1,
          "type": "string"
        },
        "protocol": {
          "const": "senagent.surface-host.v1"
        },
        "type": {
          "const": "senagent.surface.notify"
        }
      },
      "required": [
        "type",
        "protocol",
        "message"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "senagent.surface-host.v1"
        },
        "type": {
          "const": "senagent.surface.access.refresh"
        }
      },
      "required": [
        "type",
        "protocol"
      ],
      "type": "object"
    }
  ],
  "title": "SenAgent surface host bridge v1"
}
