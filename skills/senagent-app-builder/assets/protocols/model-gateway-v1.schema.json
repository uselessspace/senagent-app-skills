    "ModelGatewayAttributionContext": {
      "additionalProperties": false,
      "description": "Runtime 发送给独立模型网关的可信、非业务语义归因维度。",
      "properties": {
        "agent_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "application_instance_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Application Instance Id",
          "type": "string"
        },
        "application_template_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Application Template Id",
          "type": "string"
        },
        "application_template_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Application Template Version",
          "type": "string"
        },
        "client_request_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Client Request Id",
          "type": "string"
        },
        "consumer_system_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Consumer System Id",
          "type": "string"
        },
        "department_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Department Ids",
          "type": "array"
        },
        "idempotency_key": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Idempotency Key",
          "type": "string"
        },
        "initiated_by_subject_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Initiated By Subject Id",
          "type": "string"
        },
        "invocation_origin": {
          "enum": [
            "interactive",
            "delegated",
            "background",
            "tool"
          ],
          "title": "Invocation Origin",
          "type": "string"
        },
        "model_capability_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model Capability Id",
          "type": "string"
        },
        "organization_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "consumer_system_id",
        "organization_id",
        "application_template_id",
        "application_template_version",
        "application_instance_id",
        "turn_id",
        "agent_id",
        "model_capability_id",
        "initiated_by_subject_id",
        "invocation_origin",
        "client_request_id",
        "idempotency_key"
      ],
